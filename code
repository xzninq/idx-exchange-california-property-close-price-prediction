    district_col = find_column(df, ["HighSchoolDistrict", "High School District"])
    df["SchoolDistrict"] = df[district_col]
    n_matched = df["SchoolDistrict"].notna().sum()
    print(f"Falling back to the '{district_col}' field already in the MLS export: "
          f"{n_matched} / {len(df)} properties have a district "
          f"({n_matched / len(df):.1%}).")
    school_join_method = f"fallback_column:{district_col}"

