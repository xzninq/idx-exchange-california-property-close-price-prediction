# --- School district layer ------------------------------------------------
school_join_method = None
try:
    import geopandas as gpd
    from shapely.geometry import Point

    districts_url = ("https://gis.data.ca.gov/api/download/v1/items/"
                      "b0e3b936426a47ce9d9a2e77e2bb86cc/geojson?layers=0")
    districts = gpd.read_file(districts_url)
    print(f"Loaded {len(districts)} school district polygons")

    def find_gdf_column(gdf, candidates):
        norm_map = {normalize(c): c for c in gdf.columns}
        for cand in candidates:
            key = normalize(cand)
            if key in norm_map:
                return norm_map[key]
        raise KeyError(f"None of {candidates} found in columns: {gdf.columns.tolist()}")

    district_name_col = find_gdf_column(districts, ["DistrictName", "District Name", "District", "NAME", "Name"])

    districts = districts.set_crs(epsg=4326) if districts.crs is None else districts.to_crs(epsg=4326)

    df_before_join = len(df)
    geometry = [Point(xy) for xy in zip(df[COL["longitude"]], df[COL["latitude"]])]
    properties_gdf = gpd.GeoDataFrame(df.copy(), geometry=geometry, crs="EPSG:4326")

    joined = gpd.sjoin(
        properties_gdf,
        districts[[district_name_col, "geometry"]],
        how="left",
        predicate="within",
    )
    joined = joined[~joined.index.duplicated(keep="first")]
    df["SchoolDistrict"] = joined[district_name_col]

    n_matched = df["SchoolDistrict"].notna().sum()
    print(f"Matched {n_matched} / {df_before_join} properties to a school district "
          f"({n_matched / df_before_join:.1%}) via spatial join")
    school_join_method = "spatial_join"

except Exception as e:
