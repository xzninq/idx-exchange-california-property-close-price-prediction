      f"(ClosePrice between ${price_lo:,.0f} and ${price_hi:,.0f})")


def make_preprocessor(numeric_feats, categorical_feats):
    """Build a fresh ColumnTransformer -- kept as a function so Week 6's
    expanded feature set doesn't get fit/transformed through a preprocessor
    that was already fit on the old feature set."""
    return ColumnTransformer([
        ("num", Pipeline([
            ("impute", SimpleImputer(strategy="median")),
            ("scale", StandardScaler()),
        ]), numeric_feats),
        ("cat", Pipeline([
            ("impute", SimpleImputer(strategy="most_frequent")),
            ("onehot", OneHotEncoder(handle_unknown="ignore")),
        ]), categorical_feats),
    ])

# Train/test split: most recent month = test set, X months immediately
# before it = training set. X is tuned by trying every possible window
# length and keeping whichever gives the best test R².
months_sorted = sorted(df["month"].unique())
test_month = months_sorted[-1]
max_x = len(months_sorted) - 1  # months available before the test month

if max_x < 1:
    raise ValueError("Need at least 2 months of data (1 train + 1 test).")

window_results = {}
for x in range(1, max_x + 1):
    train_months = months_sorted[-1 - x:-1]  # x months right before test_month

    train_df = df[df["month"].isin(train_months)]
    test_df = df[df["month"] == test_month]
    if train_df.empty or test_df.empty:
        continue

    preprocessor = make_preprocessor(numeric_features, categorical_features)
    X_train = preprocessor.fit_transform(train_df[numeric_features + categorical_features])
    X_test = preprocessor.transform(test_df[numeric_features + categorical_features])
    y_train, y_test = train_df[target], test_df[target]

    model = LinearRegression()
    model.fit(X_train, y_train)
    preds = model.predict(X_test)

    window_results[x] = r2_score(y_test, preds)
    print(f"X={x} training month(s) -> test R\u00b2 = {window_results[x]:.4f}")

best_x = max(window_results, key=window_results.get)
print(f"\nBest training window: X={best_x} months (R\u00b2={window_results[best_x]:.4f})")

pd.Series(window_results).sort_index().to_csv(os.path.join(OUTPUT_DIR, "window_tuning_results.csv"))

