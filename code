def normalize(s):
    return re.sub(r"[^a-z0-9]", "", s.lower())


def find_column(frame, candidates):
    """Return the first actual column name in frame matching any candidate,
    ignoring spaces/case/punctuation. Raises a clear error if none found."""
    norm_map = {normalize(c): c for c in frame.columns}
    for cand in candidates:
        key = normalize(cand)
        if key in norm_map:
            return norm_map[key]
    raise KeyError(f"None of {candidates} found in columns: {frame.columns.tolist()}")

